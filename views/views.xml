<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="projects_list" model="ir.ui.view">
        <field name="name">Projects</field>
        <field name="model">sd_hse_forms.projects</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_code"/>
            </list>
        </field>
    </record>
    <record id="projects_form" model="ir.ui.view">
        <field name="name">Projects</field>
        <field name="model">sd_hse_forms.projects</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                <group>
                    <group>
                        <field name="name"/>
                        <field name="project_code"/>

                    </group>
                </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sd_hse_forms_action" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">sd_hse_forms.projects</field>
        <field name="view_mode">list,form</field>

    </record>

    <menuitem
        name="HSE Projects"
        id="sd_hse_root_menu"
        action="sd_hse_forms_action"
    />

</odoo>